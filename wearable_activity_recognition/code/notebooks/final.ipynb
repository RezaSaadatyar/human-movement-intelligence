    "# =================== 02. Load Required Research Outputs ======================\n",
    "\n",
    "# --------------------- 1. Declare Required Source Files ----------------------\n",
    "required_sources = {\n",
    "    8: (\"08_development_cohort_summary.csv\",\n",
    "        {\"subject_id\", \"eligible_windows\"}),\n",
    "    9: (\"09_development_cv_model_summary.csv\",\n",
    "        {\"model\", \"fold_macro_f1_mean\"}),\n",
    "    10: (\"10_development_cohort_summary.csv\",\n",
    "         {\"subject_id\", \"sampled_windows\"}),\n",
    "    13: (\"13_matched_cv_model_summary.csv\",\n",
    "         {\"model\", \"macro_f1_mean\"}),\n",
    "    14: (\"14_sampling_policy_class_counts.csv\",\n",
    "         {\"policy\", \"label\", \"windows\"}),\n",
    "    15: (\"15_nested_development_cohort_summary.csv\",\n",
    "         {\"subject_id\", \"eligible_windows\", \"base_windows\", \"expanded_windows\"}),\n",
    "    16: (\"16_nested_cv_model_summary.csv\",\n",
    "         {\"model\", \"macro_f1_mean\"}),\n",
    "    17: (\"17_fixed_step_model_summary.csv\",\n",
    "         {\"model\", \"macro_f1_mean\"}),\n",
    "    19: (\"19_temperature_scaling_mean_metrics.csv\",\n",
    "         {\"method\", \"nll\", \"ece\", \"brier\", \"accuracy\"}),\n",
    "}\n",
    "\n",
    "# ----------------------- 2. Load and Check Each CSV --------------------------\n",
    "source_tables = {}\n",
    "source_records = []\n",
    "\n",
    "for stage, (filename, required_columns) in required_sources.items():\n",
    "    path = output_dir / filename\n",
    "    if not path.is_file():\n",
    "        raise FileNotFoundError(\n",
    "            f\"Stage 20 requires {filename} from Stage {stage:02d}. \"\n",
    "            \"Run that stage, save its CSV outputs, and copy the file into \"\n",
    "            f\"{output_dir} before rerunning Stage 20.\"\n",
    "        )\n",
    "\n",
    "    table = pd.read_csv(path)\n",
    "    missing_columns = required_columns - set(table.columns)\n",
    "    if table.empty or missing_columns:\n",
    "        raise ValueError(\n",
    "            f\"Invalid source CSV {filename}: \"\n",
    "            f\"empty={table.empty}, missing columns={sorted(missing_columns)}\"\n",
    "        )\n",
    "\n",
    "    source_tables[stage] = table\n",
    "    source_records.append({\n",
    "        \"source_stage\": stage,\n",
    "        \"source_file\": filename,\n",
    "        \"rows\": len(table),\n",
    "        \"columns\": len(table.columns),\n",
    "    })\n",
    "\n",
    "source_manifest = pd.DataFrame(source_records)\n",
    "display(source_manifest)\n",
    "print(f\"Required source CSVs loaded: {len(source_manifest)}\")"
