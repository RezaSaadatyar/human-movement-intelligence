    "# ================ 08. Consolidate Calibration Metrics ========================\n",
    "\n",
    "# ---------------------- 1. Read Current Stage 19 Metrics ---------------------\n",
    "calibration_source = source_tables[19].set_index(\"method\")\n",
    "metric_names = {\n",
    "    \"ece\": \"ECE (10 bins)\",\n",
    "    \"brier\": \"Multiclass Brier\",\n",
    "    \"nll\": \"NLL\",\n",
    "    \"accuracy\": \"Accuracy\",\n",
    "}\n",
    "calibration = pd.DataFrame([\n",
    "    {\n",
    "        \"metric\": name,\n",
    "        \"uncalibrated\": float(calibration_source.loc[\"Uncalibrated\", metric]),\n",
    "        \"temperature_scaled\": float(\n",
    "            calibration_source.loc[\"Temperature scaled\", metric]\n",
    "        ),\n",
    "    }\n",
    "    for metric, name in metric_names.items()\n",
    "])\n",
    "calibration[\"change_after_minus_before\"] = (\n",
    "    calibration[\"temperature_scaled\"] - calibration[\"uncalibrated\"]\n",
    ")\n",
    "assert np.isfinite(calibration[[\n",
    "    \"uncalibrated\", \"temperature_scaled\"\n",
    "]].to_numpy()).all()\n",
    "display(calibration.round(4))\n",
    "\n",
    "print(\"Calibration comparison loaded from Stage 19 output, not notebook history.\")"
   ]
