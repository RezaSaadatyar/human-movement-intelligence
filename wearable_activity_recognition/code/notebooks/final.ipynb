    "# ================ 06. Consolidate Source Model Metrics =======================\n",
    "\n",
    "# -------------------- 1. Read Model Performance by Stage ---------------------\n",
    "metric_sources = {\n",
    "    9: (\"fold_macro_f1_mean\", \"Full Development; five grouped folds\"),\n",
    "    13: (\"macro_f1_mean\", \"Matched bounded three-fold model comparison\"),\n",
    "    16: (\"macro_f1_mean\", \"Nested Train; matched three-fold Validation\"),\n",
    "    17: (\"macro_f1_mean\", \"Fixed 400-step nested CNN comparison\"),\n",
    "}\n",
    "score_frames = []\n",
    "\n",
    "for stage, (metric_column, protocol) in metric_sources.items():\n",
    "    frame = source_tables[stage][[\"model\", metric_column]].copy()\n",
    "    frame = frame.rename(columns={metric_column: \"mean_macro_f1\"})\n",
    "    frame.insert(0, \"stage\", stage)\n",
    "    frame.insert(1, \"protocol\", protocol)\n",
    "    score_frames.append(frame)\n",
    "\n",
    "grouped_scores = (\n",
    "    pd.concat(score_frames, ignore_index=True)\n",
    "    .sort_values([\"stage\", \"model\"]).reset_index(drop=True)\n",
    ")\n",
    "display(grouped_scores.round(4))\n",
    "\n",
    "# ------------------ 2. Visualise Within-Protocol Comparisons -----------------\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "for ax, stage in zip(axes, (13, 17)):\n",
    "    group = grouped_scores.loc[grouped_scores[\"stage\"] == stage]\n",
    "    ax.barh(group[\"model\"], group[\"mean_macro_f1\"])\n",
    "    ax.set(title=f\"Stage {stage}: matched Development comparison\",\n",
    "           xlabel=\"Mean held-out-fold Macro F1\", xlim=(0, 1))\n",
    "    ax.grid(axis=\"x\", alpha=0.2)\n",
    "\n",
    "fig.tight_layout()\n",
    "save_figure(fig, output_dir / \"20_historical_matched_protocol_scores.png\")\n",
    "plt.show()"
   ]
  },
