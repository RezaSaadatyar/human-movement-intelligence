    "        f\"Stage {stage:02d} must cover 29 Development participants\"\n",
    "    )\n",
    "\n",
    "subjects_08 = set(source_tables[8][\"subject_id\"])\n",
    "assert subjects_08 == set(source_tables[10][\"subject_id\"])\n",
    "assert subjects_08 == set(source_tables[15][\"subject_id\"])\n",
    "assert not (subjects_08 & {\"S023\", \"S032\"})\n",
    "\n",
