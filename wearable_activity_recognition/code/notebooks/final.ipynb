   "source": [
    "# ================== 07. Consolidate Minority-Class Counts ====================\n",
    "\n",
    "# -------------------- 1. Read Policy Counts for Rare Classes -----------------\n",
    "source_counts = source_tables[14]\n",
    "assert not source_counts.duplicated([\"policy\", \"label\"]).any()\n",
    "assert pd.to_numeric(source_counts[\"windows\"], errors=\"raise\").ge(0).all()\n",
    "\n",
    "rare_support = (\n",
    "    source_counts.loc[source_counts[\"label\"].isin([3, 4, 5])]\n",
    "    .pivot(index=\"label\", columns=\"policy\", values=\"windows\")\n",
    "    .reset_index()\n",
    ")\n",
    "required_policies = {\"full\", \"cap_500\", \"cap_1000\"}\n",
    "assert required_policies.issubset(rare_support.columns)\n",
    "assert rare_support[\"label\"].nunique() == 3\n",
    "\n",
    "rare_support = rare_support.rename(\n",
    "    columns={\"cap_1000\": \"cap_1000_independent\"}\n",
    ")\n",
    "rare_support.insert(\n",
    "    1, \"activity\", rare_support[\"label\"].map(ACTIVITY_NAMES)\n",
    ")\n",
    "rare_support[\"retained_500_pct\"] = (\n",
    "    rare_support[\"cap_500\"] / rare_support[\"full\"] * 100\n",
    ")\n",
    "rare_support[\"retained_1000_pct\"] = (\n",
    "    rare_support[\"cap_1000_independent\"] / rare_support[\"full\"] * 100\n",
    ")\n",
    "display(rare_support.round(2))\n",
    "\n",
    "# --------------------- 2. Plot Minority-Class Retention ----------------------\n",
    "ax = rare_support.set_index(\"activity\")[\n",
    "    [\"retained_500_pct\", \"retained_1000_pct\"]\n",
    "].plot(kind=\"bar\", figsize=(11, 4.5), rot=0)\n",
    "ax.set(title=\"Minority activity windows retained by sampling policy\",\n",
    "       ylabel=\"Percentage of eligible windows\")\n",
    "ax.grid(axis=\"y\", alpha=0.2)\n",
    "plt.tight_layout()\n",
    "save_figure(ax.figure, output_dir / \"20_historical_minority_activity_retention.png\")\n",
    "plt.show()"
   ]
  },
