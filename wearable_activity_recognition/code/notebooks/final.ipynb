    "for stage in (9, 13, 16, 17):\n",
    "    table = source_tables[stage]\n",
    "    metric_column = (\n",
    "        \"fold_macro_f1_mean\" if stage == 9 else \"macro_f1_mean\"\n",
    "    )\n",
    "    assert table[\"model\"].is_unique, f\"Duplicate model in Stage {stage}\"\n",
    "    values = pd.to_numeric(table[metric_column], errors=\"raise\")\n",
    "    assert values.notna().all() and values.between(0, 1).all(), (\n",
    "        f\"Invalid Macro F1 in Stage {stage}\"\n",
    "    )\n",
