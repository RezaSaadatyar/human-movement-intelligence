    "# ======================== 00. Colab Repository Setup =========================\n",
    "\n",
    "# -------------------- 1. Clone or Safely Refresh Checkout --------------------\n",
    "from pathlib import Path\n",
    "import subprocess\n",
    "\n",
    "repo_url = \"https://github.com/RezaSaadatyar/human-movement-intelligence.git\"\n",
    "repo_path = Path(\"/content\") / repo_url.split(\"/\")[-1].removesuffix(\".git\")\n",
    "\n",
    "%cd /content\n",
    "\n",
    "if not repo_path.exists():\n",
    "    subprocess.run([\"git\", \"clone\", \"-q\", repo_url], check=True)\n",
    "else:\n",
    "    if not (repo_path / \".git\").is_dir():\n",
    "        raise RuntimeError(f\"Existing path is not a Git checkout: {repo_path}\")\n",
    "    status = subprocess.run(\n",
    "        [\"git\", \"-C\", str(repo_path), \"status\", \"--porcelain\"],\n",
    "        check=True, capture_output=True, text=True,\n",
    "    )\n",
    "    if status.stdout.strip():\n",
    "        raise RuntimeError(\n",
    "            \"Repository contains local changes. They have not been overwritten. \"\n",
    "            \"Review or save those changes before synchronising with GitHub.\"\n",
    "        )\n",
    "    subprocess.run(\n",
    "        [\"git\", \"-C\", str(repo_path), \"pull\", \"--ff-only\"],\n",
    "        check=True,\n",
    "    )\n",
    "\n",
    "# ---------------------------- 2. Open Repository -----------------------------\n",
    "%cd {repo_path}\n",
    "commit = subprocess.run(\n",
    "    [\"git\", \"-C\", str(repo_path), \"rev-parse\", \"--short\", \"HEAD\"],\n",
    "    check=True, capture_output=True, text=True,\n",
    ").stdout.strip()\n",
    "print(\"HARTH repository commit:\", commit)\n"
   ]
  },
